{
  // Don't put settings here: this file is replaced on every upgrade. MediaRiffle's settings go in
  // /etc/mediariffle/appsettings.json (Linux) or %ProgramData%\MediaRiffle\appsettings.json (Windows), which upgrades
  // keep; see docs/configuration.md. The defaults are built in.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
