# Settings for the container's first boot (mediariffle-firstboot), applied to /etc/mediariffle/appsettings.json.
# Uncomment and set before starting the container (pct mount, or edit and run mediariffle-firstboot again), or
# change appsettings.json itself later. See docs/configuration.md.

# The port MediaRiffle listens on, on every address of the container
#MEDIARIFFLE_PORT=5080

# The reverse proxies in front (HAProxy, nginx, …), so MediaRiffle sees each visitor's real address and that the
# visit was HTTPS: their addresses, separated by spaces or commas (e.g. both OPNsense firewalls and their CARP address)
#MEDIARIFFLE_TRUSTED_PROXIES="192.168.0.1 192.168.0.2 192.168.0.3"

# How many proxies sit in a row in front (1 for HAProxy alone, 2 for HAProxy -> nginx)
#MEDIARIFFLE_FORWARD_LIMIT=1
