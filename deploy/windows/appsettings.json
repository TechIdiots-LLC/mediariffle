{
  // MediaRiffle settings (docs/configuration.md). The installer writes this only when there isn't one, so your edits
  // are kept across upgrades. Restart the MediaRiffle service after changing it.
  "MediaRiffle": {
    // Addresses of the reverse proxies in front (HAProxy, Apache, nginx), and how many there are in a row
    "TrustedProxies": [ "127.0.0.1", "::1" ],
    "ForwardLimit": 1,
    "Transcoding": {
      // Where ffmpeg.exe and ffprobe.exe are; empty to use PATH. Use \\ for each \ in JSON.
      "FfmpegFolder": "C:\\Tools\\ffmpeg\\bin",
      // Libx264 (CPU), Qsv (Intel Quick Sync), Nvenc (NVIDIA)
      "Encoder": "Libx264"
    }
    // Libraries are added in the browser: Admin → Libraries (UNC paths such as \\server\share\Shows work)
  },
  "Kestrel": {
    // localhost when the proxy runs on this machine; this machine's LAN address (or 0.0.0.0) when it doesn't
    // (then allow only the proxy through the firewall)
    "Endpoints": { "Http": { "Url": "http://localhost:5080" } }
  }
}
