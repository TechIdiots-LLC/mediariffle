{
  // MediaRiffle settings (docs/configuration.md). Kept across upgrades.
  "MediaRiffle": {
    // Addresses of the reverse proxies in front (HAProxy, Apache, nginx), and how many there are in a row
    "TrustedProxies": [ "127.0.0.1", "::1" ],
    "ForwardLimit": 1,
    "Transcoding": {
      // Libx264 (CPU), Qsv or Vaapi (Intel), Nvenc (NVIDIA)
      "Encoder": "Libx264"
    }
    // Libraries are added in the browser: Admin → Libraries
  },
  "Kestrel": {
    // 127.0.0.1 when the proxy runs on this machine; this machine's LAN address when it doesn't
    // (then allow only the proxy to reach the port)
    "Endpoints": { "Http": { "Url": "http://127.0.0.1:5080" } }
  }
}
